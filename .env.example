# ==============================================================================
# MotorCare Environment & Authentication Secrets Example (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual API keys & credentials.

# 1. Google OAuth 2.0 Client IDs
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:8089, https://your-custom-domain.com
# Authorized redirect URIs: http://localhost:8089/index.html, https://your-custom-domain.com
VITE_GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# Android Client ID (Package: com.motorcare.app, SHA-1 Fingerprint from Keystore)
VITE_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_here.apps.googleusercontent.com

# 2. Application Base URL
VITE_APP_URL=http://localhost:8089

# 3. Native Application Scheme
VITE_CAPACITOR_SCHEME=com.motorcare.app

# 4. Backend Cloud Webhook Endpoint
VITE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbw9i9HjQRN3909_EPXzWz6ZzbDqXJDYoIudlwPVa6mvECeCx9PQoXNDnwpo9RrpxjKe2A/exec
